#!/usr/bin/env bash
# Configures a brand new Ubuntu machine with Nginx so that:
#  - /redirect_me issues a "301 Moved Permanently" redirect
#  - unknown pages return a 404 with a custom page
#  - every response carries an X-Served-By header holding the
#    hostname of the server Nginx is running on

CONF="/etc/nginx/sites-available/default"
TARGET="https://www.youtube.com/watch?v=QH2-TGUlwu4"

# Use sudo only when not already root (some environments have no sudo)
if [ "$(id -u)" -ne 0 ]; then
    SUDO="sudo"
else
    SUDO=""
fi

# Install Nginx
$SUDO apt-get update -y
$SUDO apt-get install -y nginx

# Serve a simple page at the root
echo "Hello World!" | $SUDO tee /var/www/html/index.nginx-debian.html > /dev/null

# Create the custom 404 page
echo "Ceci n'est pas une page" | $SUDO tee /var/www/html/404.html > /dev/null

# Add the redirection rule right after the server_name line (only once)
if ! grep -q "location /redirect_me" "$CONF"; then
    $SUDO sed -i "s|server_name _;|server_name _;\n\n\tlocation /redirect_me {\n\t\treturn 301 $TARGET;\n\t}|" "$CONF"
fi

# Add the custom 404 handling (only once)
if ! grep -q "error_page 404" "$CONF"; then
    $SUDO sed -i "s|server_name _;|server_name _;\n\n\terror_page 404 /404.html;\n\tlocation = /404.html {\n\t\troot /var/www/html;\n\t\tinternal;\n\t}|" "$CONF"
fi

# Add the custom header (only once). $hostname is a built-in Nginx variable,
# so it is written literally (single quotes) and resolved by Nginx per server.
if ! grep -q "X-Served-By" "$CONF"; then
    $SUDO sed -i 's|server_name _;|server_name _;\n\n\tadd_header X-Served-By $hostname always;|' "$CONF"
fi

# Validate the configuration, then make sure Nginx is running with it
$SUDO nginx -t
$SUDO service nginx restart || $SUDO nginx
