#!/usr/bin/env bash
# Configures a brand new Ubuntu machine with Nginx so that
# /redirect_me issues a "301 Moved Permanently" redirect.

CONF="/etc/nginx/sites-available/default"
TARGET="https://www.youtube.com/watch?v=QH2-TGUlwu4"

# Use sudo only when not already root (some environments have no sudo)
if [ "$(id -u)" -ne 0 ]; then
    SUDO="sudo"
else
    SUDO=""
fi

# Install Nginx
$SUDO apt-get update -y
$SUDO apt-get install -y nginx

# Serve a simple page at the root
echo "Hello World!" | $SUDO tee /var/www/html/index.nginx-debian.html > /dev/null

# Add the redirection rule right after the server_name line (only once)
if ! grep -q "location /redirect_me" "$CONF"; then
    $SUDO sed -i "s|server_name _;|server_name _;\n\n\tlocation /redirect_me {\n\t\treturn 301 $TARGET;\n\t}|" "$CONF"
fi

# Validate the configuration, then make sure Nginx is running with it
$SUDO nginx -t
$SUDO service nginx restart || $SUDO nginx
